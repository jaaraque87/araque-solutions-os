# ─────────────────────────────────────────────────────────────────────────────
# KENZA UGC PIPELINE — Environment Variables
# Copy this file to .env and fill in your real keys. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── OPERATOR ─────────────────────────────────────────────────────────────────
OPERATOR_NAME=Paul
AGENCY_NAME=Morfeo Academy

# ── FAL.AI ──────────────────────────────────────────────────────────────────
# Used by: morpheus (GPT Image 2 Edit), kling, sync
# Get your key at: https://fal.ai/dashboard/keys
FAL_KEY=
# Alias accepted by fal-client SDK:
FAL_API_KEY=

# ── OPENAI ───────────────────────────────────────────────────────────────────
# Optional BYOK for GPT Image 2 Edit via fal.ai
# If present, image usage is billed to your OpenAI account instead of fal credits
OPENAI_API_KEY=

# ── GOOGLE GEMINI ─────────────────────────────────────────────────────────────
# Used by: brand-analyzer (web research), tts (Gemini 3.1 Flash TTS)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── ELEVEN LABS ───────────────────────────────────────────────────────────────
# Used by: voice-change (speech-to-speech after Gemini TTS)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Default voice ID to use for Kenza (find IDs at GET /v1/voices)
ELEVENLABS_VOICE_ID=

# ── KIE.AI (SUNO) ─────────────────────────────────────────────────────────────
# Used by: music (Suno V4_5PLUS background track generation)
KIE_API_KEY=

# ── COMFYDEPLOY ───────────────────────────────────────────────────────────────
# Used by: portrait ALTERNATIVE path (AION ComfyDeploy workflow)
# Main path for personaje/locacion is GPT Image 2 via fal.ai (no ComfyDeploy needed)
COMFYDEPLOY_API_KEY=
COMFYDEPLOY_DEPLOYMENT_ID=
COMFYDEPLOY_API_BASE=https://api.comfydeploy.com/api
# Optional override if your ComfyDeploy workspace exposes a different run endpoint.
# Use {deployment_id} in the URL if needed.
COMFYDEPLOY_RUN_URL=

# ── SUBMAGIC ──────────────────────────────────────────────────────────────────
# Used by: subs (step 11) — subtitles burn-in + finishing
# Get your key at: https://submagic.co
SUBMAGIC_API_KEY=

# ── PIPELINE DEFAULTS ─────────────────────────────────────────────────────────
# Number of scenes to generate per run
DEFAULT_NUM_SCENES=6
# Output format for video (9:16 = vertical/Reels, 16:9 = horizontal, 1:1 = square)
DEFAULT_FORMAT=9:16
# Image quality for Morpheus/GPT Image 2 (low / medium / high)
DEFAULT_IMAGE_QUALITY=high
# Kling model to use
DEFAULT_KLING_MODEL=fal-ai/kling-video/o3/pro/reference-to-video
# Gemini TTS voice (see tts skill for full list — Leda=youthful, Kore=firm, Aoede=breezy)
DEFAULT_GEMINI_VOICE=Leda

# ── PATHS ─────────────────────────────────────────────────────────────────────
# Absolute path to brands folder (defaults to ./brands relative to project root)
# BRANDS_DIR=C:\Users\SOPORTE2\Documents\Kenza UGC Pipeline\brands
# Absolute path to outputs folder
# OUTPUTS_DIR=C:\Users\SOPORTE2\Documents\Kenza UGC Pipeline\outputs
